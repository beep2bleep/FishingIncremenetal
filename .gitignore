
# Don't commit Godot editor binaries
Godot/*.exe

# Ignore build output and project-specific Godot configs
/Build/
/Build - Mining/
/Build - Red Sky/
/Build - */

# ignore all Godot project config directories
**/.godot/

# Ignore Godot export package files
*.pck
*.TMP

# Ignore local validation output
**/.validation/

# Local Python simulation/import bytecode
__pycache__/

# Local client analytics configuration is bundled in builds, never committed.
/FeedingABlackHoldGame/railway_analytics.local.cfg
/output/railway-fury-trailer*/
